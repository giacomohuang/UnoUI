{
  "name": "unoui",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @mcistudio/unoui-vue build",
    "build:ex": "pnpm --filter @unoui/example build",
    "dev:ex": "pnpm --filter @unoui/example dev",
    "release": "node scripts/release.mjs",
    "skills:check": "scripts/install-skills.sh --check",
    "skills:install": "scripts/install-skills.sh",
    "test:unit": "pnpm --filter @mcistudio/unoui-vue test:unit",
    "typecheck": "pnpm --filter @mcistudio/unoui-vue typecheck && pnpm --filter @unoui/example typecheck"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
