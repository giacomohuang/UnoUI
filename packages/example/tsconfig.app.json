{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/**/*.d.ts", "src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "incremental": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@mcistudio/unoui-vue": ["../vue/src/index.ts"],
      "@mcistudio/unoui-vue/attrs": ["../vue/src/attrs.ts"],
      "@mcistudio/unoui-vue/config": ["../vue/src/config.ts"],
      "@mcistudio/unoui-vue/uno": ["../vue/src/uno.ts"],
      "@mcistudio/unoui-vue/colorpicker/color": ["../vue/src/colorpicker/color.ts"],
      "@mcistudio/unoui-vue/table/types": ["../vue/src/table/types.ts"],
      "@mcistudio/unoui-vue/*": ["../vue/src/*/index.ts"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  }
}
