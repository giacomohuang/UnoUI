{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/**/*.d.ts", "src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "incremental": true,
    "types": ["vite/client"],
    "paths": {
      "@mcistudio/unoui-vue": ["./src/index.ts"],
      "@mcistudio/unoui-vue/attrs": ["./src/attrs.ts"],
      "@mcistudio/unoui-vue/config": ["./src/config.ts"],
      "@mcistudio/unoui-vue/uno": ["./src/uno.ts"],
      "@mcistudio/unoui-vue/colorpicker/color": ["./src/colorpicker/color.ts"],
      "@mcistudio/unoui-vue/table/types": ["./src/table/types.ts"],
      "@mcistudio/unoui-vue/*": ["./src/*/index.ts"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  }
}
