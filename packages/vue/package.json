{
  "name": "@unoui/vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UnoCSS based Vue 3 UI primitives extracted from vmap admin.",
  "sideEffects": [
    "**/*.css",
    "**/*.vue"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./style.css": "./src/style.css",
    "./attrs": {
      "types": "./src/attrs.ts",
      "import": "./src/attrs.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./src/config.ts"
    },
    "./uno": {
      "types": "./src/uno.ts",
      "import": "./src/uno.ts"
    },
    "./colorpicker/color": {
      "types": "./src/colorpicker/color.ts",
      "import": "./src/colorpicker/color.ts"
    },
    "./table/types": {
      "types": "./src/table/types.ts",
      "import": "./src/table/types.ts"
    },
    "./*": {
      "types": "./src/*/index.ts",
      "import": "./src/*/index.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "build": "vue-tsc -b && vite build",
    "dev": "vite",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:fix": "oxfmt --fix",
    "test:unit": "vitest",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "async-validator": "^4.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "simplebar-vue": "^2.4.2"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-i18n": "^11.0.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.0.1",
    "@unocss/preset-icons": "^66.7.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.56.0",
    "oxlint": "~1.71.0",
    "sass-embedded": "^1.100.0",
    "typescript": "~6.0.3",
    "unocss": "^66.7.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
