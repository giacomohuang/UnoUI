{
  "name": "@mcistudio/unoui-vue",
  "version": "1.2.0",
  "description": "Vue 3 admin UI components powered by UnoCSS.",
  "keywords": [
    "components",
    "ui",
    "unocss",
    "vue",
    "vue3"
  ],
  "homepage": "https://github.com/giacomohuang/UnoUI#readme",
  "bugs": {
    "url": "https://github.com/giacomohuang/UnoUI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giacomohuang/UnoUI.git",
    "directory": "packages/vue"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/style.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./attrs": {
      "types": "./dist/attrs.d.ts",
      "import": "./dist/attrs.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./uno": {
      "types": "./dist/uno.d.ts",
      "import": "./dist/uno.js"
    },
    "./colorpicker/color": {
      "types": "./dist/colorpicker/color.d.ts",
      "import": "./dist/colorpicker/color.js"
    },
    "./table/types": {
      "types": "./dist/table/types.d.ts",
      "import": "./dist/table/types.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vue-tsc -b && vite build && pnpm build:types",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "dev": "vite",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:fix": "oxfmt --fix",
    "test:unit": "vitest",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "async-validator": "^4.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cropperjs": "^1.6.2",
    "dayjs": "^1.11.21",
    "simplebar-vue": "^2.4.2"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.0.1",
    "@unocss/preset-icons": "^66.7.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.56.0",
    "oxlint": "~1.71.0",
    "sass-embedded": "^1.100.0",
    "typescript": "~6.0.3",
    "unocss": "^66.7.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6",
    "vue-tsc": "^3.3.5"
  },
  "peerDependencies": {
    "@unocss/preset-icons": "^66.7.3",
    "unocss": "^66.7.3",
    "vue": "^3.5.0",
    "vue-i18n": "^11.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
